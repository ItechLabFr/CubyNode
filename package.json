{
  "name": "cubynode",
  "version": "1.0.0-beta.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start:api": "node apps/api/src/server.mjs",
    "start:agent": "node apps/agent/src/server.mjs",
    "test": "node --test apps/api/test/*.test.mjs apps/agent/test/*.test.mjs",
    "check": "node --check apps/api/src/server.mjs && node --check apps/agent/src/server.mjs && node --check apps/api/public/app.js",
    "dev": "docker compose up --build"
  },
  "dependencies": {
    "pg": "8.23.0"
  }
}
