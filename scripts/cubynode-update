#!/usr/bin/env bash
set -Eeuo pipefail

MODE="${1:-}"
case "$MODE" in
  simple|full) ;;
  *) echo "usage: cubynode-update {simple|full}" >&2; exit 64 ;;
esac

REPO_DIR="${CUBYNODE_REPO_DIR:-/opt/cubynode}"
ENV_FILE="${CUBYNODE_ENV_FILE:-/etc/cubynode/cubynode.env}"
STATUS_FILE="${CUBYNODE_UPDATE_STATUS:-/var/lib/cubynode/update-status.json}"
LOG_FILE="${CUBYNODE_UPDATE_LOG:-/var/log/cubynode/update.log}"
CHANNEL="${CUBYNODE_UPDATE_CHANNEL:-main}"
LOCK_FILE="/run/cubynode-update.lock"

install -d -o root -g cubynode -m 0750 "$(dirname "$STATUS_FILE")" "$(dirname "$LOG_FILE")"
touch "$LOG_FILE"
chown root:cubynode "$LOG_FILE"
chmod 0640 "$LOG_FILE"
exec >>"$LOG_FILE" 2>&1

exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  echo "Another CubyNode update is already running."
  exit 75
fi

json_status() {
  local state="$1" message="$2" from="${3:-}" to="${4:-}" reboot="false"
  [[ -f /var/run/reboot-required ]] && reboot="true"
  python3 - "$STATUS_FILE" "$state" "$MODE" "$message" "$from" "$to" "$reboot" <<'PY'
import json, os, sys
from datetime import datetime, timezone
path,state,mode,message,frm,to,reboot=sys.argv[1:]
tmp=path+".tmp"
data={
  "state":state,
  "mode":mode,
  "message":message,
  "fromCommit":frm or None,
  "toCommit":to or None,
  "rebootRequired":reboot=="true",
  "updatedAt":datetime.now(timezone.utc).isoformat()
}
with open(tmp,"w",encoding="utf-8") as f:
    json.dump(data,f,ensure_ascii=False)
os.chmod(tmp,0o640)
try:
    import grp
    os.chown(tmp,0,grp.getgrnam("cubynode").gr_gid)
except Exception:
    pass
os.replace(tmp,path)
PY
}

current_commit() {
  runuser -u cubynode -- git -C "$REPO_DIR" rev-parse HEAD 2>/dev/null || true
}

BEFORE="$(current_commit)"
AFTER=""
ROLLBACK_NEEDED=0

rollback() {
  local rc=$?
  if [[ "$ROLLBACK_NEEDED" == "1" && -n "$BEFORE" ]]; then
    echo "Update failed; rolling application tree back to $BEFORE"
    runuser -u cubynode -- git -C "$REPO_DIR" reset --hard "$BEFORE" || true
    runuser -u cubynode -- npm --prefix "$REPO_DIR" install --omit=dev --no-audit --no-fund --package-lock=false || true
    systemctl restart cubynode-agent.service || true
    systemctl restart cubynode-api.service || true
  fi
  json_status "failed" "Update failed (exit $rc). See update log." "$BEFORE" "$AFTER" || true
  exit "$rc"
}
trap rollback ERR

json_status "running" "Update started." "$BEFORE" ""

if [[ "$MODE" == "full" ]]; then
  export DEBIAN_FRONTEND=noninteractive
  export LANG=C.UTF-8
  export LC_ALL=C.UTF-8
  apt-get -o Acquire::Retries=5 update
  apt-get -o Acquire::Retries=5 -y dist-upgrade
  apt-get -o Acquire::Retries=5 install -y ca-certificates curl git sudo postgresql openssl python3 util-linux
fi

echo "Fetching CubyNode channel: $CHANNEL"
runuser -u cubynode -- git -C "$REPO_DIR" fetch --prune origin "$CHANNEL"
AFTER="$(runuser -u cubynode -- git -C "$REPO_DIR" rev-parse "origin/$CHANNEL")"

if [[ "$BEFORE" == "$AFTER" && "$MODE" == "simple" ]]; then
  json_status "success" "CubyNode is already up to date." "$BEFORE" "$AFTER"
  exit 0
fi

ROLLBACK_NEEDED=1
runuser -u cubynode -- git -C "$REPO_DIR" reset --hard "origin/$CHANNEL"
runuser -u cubynode -- npm --prefix "$REPO_DIR" install --omit=dev --no-audit --no-fund --package-lock=false
runuser -u cubynode -- npm --prefix "$REPO_DIR" run check

if [[ "$MODE" == "full" ]]; then
  install -o root -g root -m 0755 "$REPO_DIR/scripts/cubynode-update" /usr/local/sbin/cubynode-update
  install -o root -g root -m 0755 "$REPO_DIR/scripts/cubynode-update-request" /usr/local/sbin/cubynode-update-request
  install -o root -g root -m 0644 "$REPO_DIR/install/systemd/cubynode-agent.service" /etc/systemd/system/cubynode-agent.service
  install -o root -g root -m 0644 "$REPO_DIR/install/systemd/cubynode-api.service" /etc/systemd/system/cubynode-api.service
  systemctl daemon-reload
fi

VERSION="$(runuser -u cubynode -- node -p "require('$REPO_DIR/package.json').version")"
if grep -q '^CUBYNODE_VERSION=' "$ENV_FILE"; then
  sed -i "s/^CUBYNODE_VERSION=.*/CUBYNODE_VERSION=$VERSION/" "$ENV_FILE"
else
  echo "CUBYNODE_VERSION=$VERSION" >>"$ENV_FILE"
fi

systemctl restart cubynode-agent.service
systemctl restart cubynode-api.service
ROLLBACK_NEEDED=0
json_status "success" "Update completed successfully." "$BEFORE" "$AFTER"
echo "CubyNode update completed: $BEFORE -> $AFTER"
