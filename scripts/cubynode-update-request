#!/usr/bin/env bash
set -Eeuo pipefail

MODE="${1:-}"
case "$MODE" in
  simple|full) ;;
  *) echo "usage: cubynode-update-request {simple|full}" >&2; exit 64 ;;
esac

if systemctl is-active --quiet cubynode-update.service 2>/dev/null; then
  echo "An update is already running." >&2
  exit 75
fi

systemd-run   --unit=cubynode-update   --collect   --property=Type=exec   --property=Nice=10   /usr/local/sbin/cubynode-update "$MODE" >/dev/null

echo "Update scheduled: $MODE"
