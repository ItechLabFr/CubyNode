# Database
POSTGRES_DB=cubynode
POSTGRES_USER=cubynode
POSTGRES_PASSWORD=replace-with-a-random-password

# Panel API access token. The web UI asks for this token on first load.
CUBYNODE_PANEL_TOKEN=replace-with-a-long-random-token

# Shared secret between the control plane and node agent.
CUBYNODE_AGENT_TOKEN=replace-with-another-long-random-token

# Local Docker node identity
CUBYNODE_NODE_ID=local-node
CUBYNODE_NODE_NAME=Local node

# Optional: change exposed panel port
CUBYNODE_HTTP_PORT=8080

# Optional: control plane can synchronize several Docker agents by comma-separated URL.
# CUBYNODE_AGENT_URLS=http://node-a:8081,http://node-b:8081
