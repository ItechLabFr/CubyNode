[Unit]
Description=CubyNode Node Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cubynode
Group=cubynode
WorkingDirectory=/opt/cubynode
EnvironmentFile=/etc/cubynode/cubynode.env
ExecStart=/usr/bin/node /opt/cubynode/apps/agent/src/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/cubynode /var/log/cubynode

[Install]
WantedBy=multi-user.target
